@import "../clinicPageShell.css";

@import "../clinicRow.css";

.staff-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border-bottom: 1px solid #e6eaf0;
  transition: opacity 0.15s;
}

.staff-row:last-child {
  border-bottom: none;
}

.staff-row.is-loading {
  opacity: 0.5;
  pointer-events: none;
}

.staff-row-invitation {
  background: #fffbeb;
}

.staff-row-avatar {
  width: 38px;
  height: 38px;
  background: #2563eb;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 14px;
  flex-shrink: 0;
}

.staff-row-avatar-pending {
  background: #f59e0b;
}

.staff-row-info {
  flex: 1;
  min-width: 0;
}

.staff-row-name {
  font-weight: 500;
  color: #1a1f2e;
  font-size: 14px;
}

.staff-row-email {
  color: #6b7280;
  font-size: 12px;
  margin-top: 2px;
}

.staff-row-role {
  flex-shrink: 0;
}

.staff-row-role-badge {
  padding: 5px 12px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border: none;
  font-family: inherit;
  cursor: default;
}

.staff-row-role-badge.is-clickable {
  cursor: pointer;
}

.staff-row-role-badge.is-clickable:hover {
  filter: brightness(0.95);
}

.staff-row-role-badge.role-owner {
  background: #fef3c7;
  color: #92400e;
}

.staff-row-role-badge.role-admin {
  background: #fee2e2;
  color: #991b1b;
}

.staff-row-role-badge.role-doctor {
  background: #dbeafe;
  color: #1e40af;
}

.staff-row-role-badge.role-manager {
  background: #ddd6fe;
  color: #5b21b6;
}

.staff-row-role-badge.role-receptionist,
.staff-row-role-badge.role-nurse,
.staff-row-role-badge.role-accountant,
.staff-row-role-badge.role-pharmacist,
.staff-row-role-badge.role-marketer {
  background: #e5e7eb;
  color: #374151;
}

.staff-row-role-edit {
  font-size: 10px;
  margin-left: 4px;
  opacity: 0.7;
}

.staff-row-role select {
  padding: 5px 10px;
  border-radius: 4px;
  border: 1px solid #2563eb;
  font-size: 12px;
  font-family: inherit;
  background: #fff;
}

.staff-row-pending-badge {
  background: #fef3c7;
  color: #92400e;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
}

.staff-row-actions {
  flex-shrink: 0;
}

.staff-row-btn-remove {
  padding: 6px 12px;
  background: transparent;
  border: 1px solid #d4dae2;
  color: #6b7280;
  border-radius: 4px;
  font-size: 12px;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.15s;
}

.staff-row-btn-remove:hover {
  border-color: #dc2626;
  color: #dc2626;
}

@keyframes staff-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 768px) {
  .staff-row {
    flex-wrap: wrap;
    gap: 10px;
  }

  .staff-row-info {
    flex: 1 1 calc(100% - 60px);
  }

  .staff-row-role {
    flex: 1 1 auto;
  }
}

.staff-row-btn-calendar {
  padding: 6px 12px;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  margin-inline-end: 6px;
}

.staff-row-btn-calendar:hover:not(:disabled) {
  background: #dbeafe;
}

.staff-row-btn-calendar:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
